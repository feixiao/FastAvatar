# Avatar 云端后台服务统一环境变量配置 (Docker Compose)
# 复制该文件为 server/.env 即可按需覆盖配置

# ================================
# 云端大模型配置 (仅由后台网关持有，对端侧客户端透明)
# ================================
# 默认直连宿主机上运行的 LM Studio (端口 :1234)
# Docker 容器内部通过 host.docker.internal 访问宿主机服务
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_API_KEY=
LLM_MODEL=default

# 如需切换为云端商业模型，直接替换为云端服务商地址与密钥即可：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-your-deepseek-key
# LLM_MODEL=deepseek-chat

# ================================
# 云端网关配置
# ================================
PORT=8088

# ================================
# LiveKit SFU 流媒体服务凭据
# ================================
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_avatar_livekit_key_2026

# ================================
# Python Agent 人格预设 (assistant, roaster, jarvis, pet)
# ================================
AGENT_PERSONA=assistant
